# CMPC Libros: variables del stack Docker. Copia este archivo a `.env`.
# ⚠ Estos valores son SÓLO para uso local. Antes de exponer el stack a una red real,
#   cambia el secreto JWT, las contraseñas y el usuario inicial.

# --- Obligatoria ---
# Secreto para firmar los JWT (HS256), mínimo 32 caracteres. Genera uno propio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (o: openssl rand -base64 48)
# El valor siguiente sirve para probar en local; no lo reutilices en ningún otro lugar.
JWT_SECRET=local-dev-secret-cambialo-por-uno-aleatorio-de-48-bytes

# --- Opcionales (estos son los valores por defecto) ---
JWT_EXPIRES_IN=12h

# Cookie de sesión: true sólo si sirves la web y la API por HTTPS.
COOKIE_SECURE=false

# Límite de login (fallos con el mismo email desde la misma IP) y nivel de logs de la API
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=30
LOG_LEVEL=info

# Base de datos (si pones caracteres especiales en la contraseña, codifícalos para URL)
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=cmpc
POSTGRES_DB=cmpc_libros

# Usuario inicial que crea el seed (también carga 10 géneros y 40 libros de ejemplo)
SEED_USER_EMAIL=admin@cmpc.cl
SEED_USER_PASSWORD=Admin1234!
SEED_USER_NAME=Administrador

# Puertos publicados en tu máquina. Si cambias alguno, el CORS y la URL de la API
# que usa el frontend se ajustan solos.
WEB_PORT=8080
API_PORT=3000

# Sólo si publicas el stack bajo otros nombres de host:
#   PUBLIC_API_URL: cómo ve el NAVEGADOR a la API (se fija al compilar el frontend)
#   CORS_ORIGINS:   origen del frontend, tal como lo ve el navegador (separados por coma)
# PUBLIC_API_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:8080

# Tamaño máximo de portada en bytes (2 MB)
UPLOAD_MAX_BYTES=2097152
