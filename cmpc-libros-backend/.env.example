# --- Servidor ---
PORT=3000
# Orígenes permitidos para CORS (separados por coma): `npm run dev` del frontend (5173) y su Docker (8080)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Docker (docker-compose.yml): puertos publicados en tu máquina ---
# API_PORT=3000      # API en el contenedor `api`
# WEB_PORT=8080      # sólo se usa para armar el CORS por defecto del contenedor

# --- Base de datos (docker-compose.yml usa POSTGRES_*) ---
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=cmpc
POSTGRES_DB=cmpc_libros
POSTGRES_PORT=5432
DATABASE_URL="postgresql://cmpc:cmpc@localhost:5432/cmpc_libros?schema=public"

# --- Autenticación JWT (HS256) ---
# Generar un secreto de al menos 32 bytes, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-bytes
JWT_EXPIRES_IN=12h

# --- Sesión (cookie HttpOnly con el JWT) ---
# true detrás de HTTPS: la cookie sólo viajará cifrada. En local (http://localhost) déjalo en false.
COOKIE_SECURE=false

# --- Límite de login: fallos con el mismo email desde la misma IP ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=30

# --- Logs (pino) ---
# production → JSON (para un agregador de logs); otro valor → formato legible
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Usuario inicial (seed) ---
SEED_USER_EMAIL=admin@cmpc.cl
SEED_USER_PASSWORD=Admin1234!
SEED_USER_NAME=Administrador

# --- Imágenes ---
UPLOADS_DIR=uploads
# Tamaño máximo por imagen en bytes (2 MB)
UPLOAD_MAX_BYTES=2097152
